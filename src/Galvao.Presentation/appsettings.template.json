{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=galvao.db"
  },
  "DatabaseOptions": {
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true,
    "CommandTimeout": 30,
    "EnableRetryOnFailure": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5
  },
  "JwtSettings": {
    "Secret": "YOUR_SUPER_LONG_JWT_SIGNING_KEY_EXCEEDING_256_BITS",
    "Issuer": "GalvaoAPI",
    "Audience": "GalvaoAPI",
    "ExpiryInMinutes": 60
  },
  "ResendSettings": {
    "ApiKey": "YOUR_RESEND_API_KEY",
    "ClientName": "galvao"
  }
}
