      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Galvao.Infrastructure\Galvao.Infrastructure.csproj" />
    <ProjectReference Include="..\Galvao.Application\Galvao.Application.csproj" />
    <ProjectReference Include="..\Galvao.Shared\Galvao.Shared.csproj" />
  </ItemGroup>

</Project>
